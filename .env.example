# Copia para .env e preenche. Sem VITE_SUBMIT_URL nada é enviado.
# Opção A — Web3Forms (https://web3forms.com): chega ao teu email
VITE_SUBMIT_URL=https://api.web3forms.com/submit
VITE_SUBMIT_KEY=cola-aqui-a-tua-access-key
# Opção B — Formspree (https://formspree.io): só o URL, sem key
# VITE_SUBMIT_URL=https://formspree.io/f/xxxxxxxx
